NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run db:migrate` / `npm run db:seed` (Supabase → Connect → Session pooler URI).
DATABASE_URL=

# Contact shown on the legal and security pages (default: contact@esriel.com).
NEXT_PUBLIC_CONTACT_EMAIL=contact@esriel.com

# Optional: public origin used in install commands (defaults to the request host).
NEXT_PUBLIC_SITE_URL=

# Optional: a GitHub token (no scopes needed) lifts the 60 requests/hour anonymous limit for GitHub imports.
GITHUB_TOKEN=

# Optional: the marketplace agent plans with Claude when set.
ANTHROPIC_API_KEY=
