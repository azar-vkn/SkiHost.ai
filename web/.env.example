NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run db:migrate` / `npm run db:seed` (Supabase → Connect → Session pooler URI).
DATABASE_URL=

# Optional: public origin used in install commands (defaults to the request host).
NEXT_PUBLIC_SITE_URL=

# Optional: the marketplace agent plans with Claude when set.
ANTHROPIC_API_KEY=
